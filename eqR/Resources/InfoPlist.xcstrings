    "NSAudioCaptureUsageDescription" : {
      "comment" : "The reason macOS shows when it asks for the audio permission. Same text as eqR’s own explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "An equalizer has to reach the sound to change it. eqR reads audio on its way to your speakers, adjusts it, and plays it straight back. Nothing is recorded, stored, or sent anywhere, and quitting eqR hands the audio back immediately."
          }
        }
      }
    },
