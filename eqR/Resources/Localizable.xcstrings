{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ copy" : {
      "comment" : "Name of a duplicated preset, such as “Jazz copy”"
    },
    "%@ decibels" : {
      "comment" : "Gain, for VoiceOver, such as “+2.5 decibels”"
    },
    "%@ downloaded" : {
      "comment" : "AutoEq catalog download progress, size unknown, such as “2 MB downloaded”"
    },
    "%@ hertz" : {

    },
    "%@ of %@" : {
      "comment" : "AutoEq catalog download progress, such as “2 MB of 5 MB”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ · %lld filters · Preamp %@" : {
      "comment" : "Import sheet heading: preset name, filter count, and output trim",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ · %#@filters@ · Preamp %3$@"
          },
          "substitutions" : {
            "filters" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filter"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg filters"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, playing %@" : {
      "comment" : "Output device, for VoiceOver: device name and its preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, playing %2$@"
          }
        }
      }
    },
    "%@, playing %@, edited" : {
      "comment" : "Output device, for VoiceOver: device name and its edited preset",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, playing %2$@, edited"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Import sheet effect row, for VoiceOver: its label and the effect",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@: %@ · %@" : {
      "comment" : "Import: which filter, what changed, and the eqR limit responsible",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ · %3$@"
          }
        }
      }
    },
    "%lld filters" : {
      "comment" : "Import alert: how many filters the preset brings in",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld filter"
